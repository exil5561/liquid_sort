  "mechanicMixTip": "Amounts must match and the target needs free space.",
  "mechanicMixCaption": "Red + Yellow = Orange",
  "mechanicFrozenTitle": "FROZEN TUBE",
  "mechanicFrozenHeadline": "Untouchable for a while",
  "mechanicFrozenBody": "You can't pour into or out of an iced tube. After enough moves, the ice melts.",
  "mechanicFrozenTip": "Open a path with other tubes; use it as soon as ice clears.",
  "mechanicFrozenCaption": "Wait moves → ice melts",
  "mechanicLockedTitle": "LOCKED TUBE",
  "mechanicLockedHeadline": "Finish another tube first",
  "mechanicLockedBody": "A locked tube stays closed until you complete a set number of tubes.",
  "mechanicLockedTip": "Finish easy tubes first, then use the locked space.",
  "mechanicLockedCaption": "Complete → unlock",
  "mechanicHeatedTitle": "HEATER TUBE",
  "mechanicHeatedHeadline": "Vaporize waste liquid",
  "mechanicHeatedBody": "Liquid poured into the heater disappears. Heat charges are limited — usually for waste colors.",
  "mechanicHeatedTip": "When heat is gone you can't pour there. Clear waste early.",
  "mechanicHeatedCaption": "Waste → vapor",
  "mechanicValveTitle": "ONE-WAY VALVE",
  "mechanicValveHeadline": "Only pours in",
  "mechanicValveBody": "You can pour into a valve tube but can't take liquid out. It acts like a permanent store.",
  "mechanicValveTip": "Wrong color can trap you. Fill valves carefully.",
  "mechanicValveCaption": "In only",
  "mechanicPortalTitle": "PORTAL PAIR",
  "mechanicPortalHeadline": "Enter one, exit the other",
  "mechanicPortalBody": "Pour into one portal and the liquid appears in its twin. The two tubes are linked.",
  "mechanicPortalTip": "Target one portal — the fill happens on the other side.",
  "mechanicPortalCaption": "A in → B out",
  "mechanicBombTitle": "BOMB TUBE",
  "mechanicBombHeadline": "Finish before the timer",
  "mechanicBombBody": "The marked tube has a countdown. Fill it with one color before it hits zero or the level fails.",
  "mechanicBombTip": "Secure the bomb tube first, then sort the rest.",
  "mechanicBombCaption": "Fill before countdown ends",
  "mechanicNarrowTitle": "NARROW TUBE",
  "mechanicNarrowHeadline": "Capacity-2 buffer",
  "mechanicNarrowBody": "This level has a short helper tube that holds at most 2 units. Use it for tight maneuvers.",
  "mechanicNarrowTip": "It must be empty to finish. Holding 2 units does not count as complete — empty it again.",
  "mechanicNarrowCaption": "Capacity 2 • empty to finish",
